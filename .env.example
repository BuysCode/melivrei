# PostgreSQL (used by the Docker Compose services)
POSTGRES_DB=melivrei
POSTGRES_USER=melivrei
POSTGRES_PASSWORD=melivrei

# Backend
# Generate a unique value before exposing the API outside local development.
BETTER_AUTH_SECRET=change-this-to-a-random-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Mercado Pago. Use test application credentials and keep split disabled until
# Checkout Pro marketplace configuration has been completed and validated.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/api/payments/mercadopago/callback
MERCADO_PAGO_TOKEN_ENCRYPTION_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://your-public-domain.example/api/payments/webhook
MERCADO_PAGO_ENVIRONMENT=test
MERCADO_PAGO_SPLIT_ENABLED=false
MERCADO_PAGO_MARKETPLACE_FEE_PERCENT=0
MERCADO_PAGO_SUCCESS_URL=http://localhost:3001/pagamento/sucesso
MERCADO_PAGO_FAILURE_URL=http://localhost:3001/pagamento/falha
MERCADO_PAGO_PENDING_URL=http://localhost:3001/pagamento/pendente
MERCADO_PAGO_CONNECTION_RETURN_URL=http://localhost:3001/conta/pagamentos
