@startuml c4-containers

title MeLivrei — C4: Diagrama de Containers

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #475569
skinparam rectangle {
    BorderColor #334155
    FontColor #0F172A
    RoundCorner 12
}

rectangle "Usuário" as user #E8F0FE
rectangle "Mercado Pago" as mercadoPago #FFF7ED

rectangle "MeLivrei" as system #F8FAFC {
    rectangle "Navegador web" as browser #E8F0FE
    rectangle "Frontend web\nNext.js + React + TypeScript\n\nCatálogo, autenticação, anúncios,\nnegociações e pagamentos." as frontend #DBEAFE
    rectangle "API REST\nNestJS + TypeScript\n\nAutenticação | Catálogo | Anúncios\nNegociações | Pagamentos | Auditoria" as api #DCFCE7
    database "Banco de dados\nPostgreSQL\nacessado via Prisma" as db #F1F5F9
end rectangle

user --> browser : Usa
browser --> frontend : HTTPS
frontend --> api : REST/JSON\nHTTPS
api --> db : Prisma/SQL
api --> mercadoPago : OAuth, criação e consulta de pagamentos\ne webhooks
mercadoPago --> api : Webhooks assinados

rectangle "Módulos principais da API" as modules #FFFFFF {
    rectangle "Identity & Access\nUsuários, autenticação e papéis" as identity #F8FAFC
    rectangle "Catalog\nLivros, anúncios e busca" as catalog #F8FAFC
    rectangle "Negotiation\nVenda, troca e estados" as negotiation #F8FAFC
    rectangle "Payment\nGateway, OAuth, checkout e webhooks" as payment #F8FAFC
    rectangle "Audit\nHistórico de operações" as audit #F8FAFC
}

api ..> identity : contém
api ..> catalog : contém
api ..> negotiation : contém
api ..> payment : contém
api ..> audit : contém

identity ..> db
catalog ..> db
negotiation ..> db
payment ..> db
audit ..> db
payment ..> mercadoPago

legend right
    |= Elemento |= Tecnologia / função |
    | <back:#E8F0FE>Ator</back> | Pessoa que usa a solução |
    | <back:#DBEAFE>Frontend</back> | Interface web executada no navegador |
    | <back:#DCFCE7>API</back> | Backend responsável pelas regras de negócio |
    | <back:#F1F5F9>Banco</back> | Persistência relacional |
    | <back:#FFF7ED>Mercado Pago</back> | OAuth, checkout e notificações |
endlegend

note bottom of api
    A API é responsável por validar permissões, transições de estado,
    confirmação de pagamentos via webhook e regras de negociação.
end note

@enduml
