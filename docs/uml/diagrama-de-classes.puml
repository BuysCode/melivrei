@startuml diagrama-de-classes

title MeLivrei — Diagrama de Classes do Domínio

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false
skinparam packageStyle rectangle

package "Identidade e acesso" {
    class User {
        +id: UUID
        +name: String
        +email: String
        -passwordHash: String
        +role: UserRole
        +status: UserStatus
        +createdAt: DateTime
        +updateProfile(): void
    }

    enum UserRole {
        USER
        ADMIN
    }

    enum UserStatus {
        ACTIVE
        SUSPENDED
        INACTIVE
    }
}

package "Catálogo" {
    class Book {
        +id: UUID
        +title: String
        +author: String
        +isbn: String
        +genre: String
    }

    class Listing {
        +id: UUID
        +description: String
        +condition: BookCondition
        +mode: ListingMode
        +price: Money
        +status: ListingStatus
        +publish(): void
        +reserve(): void
        +close(): void
    }

    class ListingImage {
        +id: UUID
        +url: String
        +altText: String
    }

    enum BookCondition {
        NEW
        LIKE_NEW
        GOOD
        FAIR
        DAMAGED
    }

    enum ListingMode {
        SALE
        TRADE
    }

    enum ListingStatus {
        AVAILABLE
        RESERVED
        IN_NEGOTIATION
        UNAVAILABLE
        COMPLETED
        CANCELLED
    }
}

package "Negociações" {
    class Negotiation {
        +id: UUID
        +type: NegotiationType
        +status: NegotiationStatus
        +createdAt: DateTime
        +accept(): void
        +reject(): void
        +cancel(): void
        +complete(): void
    }

    class TradeOffer {
        +id: UUID
        +message: String
        +status: TradeOfferStatus
        +accept(): void
        +reject(): void
    }

    enum NegotiationType {
        SALE
        TRADE
    }

    enum NegotiationStatus {
        PENDING
        PENDING_PAYMENT
        APPROVED
        REJECTED
        CANCELLED
        COMPLETED
    }

    enum TradeOfferStatus {
        PENDING
        ACCEPTED
        REJECTED
        CANCELLED
    }
}

package "Pagamentos" {
    class Payment {
        +id: UUID
        +provider: PaymentProvider
        +providerPaymentId: String
        +amount: Money
        +purpose: PaymentPurpose
        +status: PaymentStatus
        +createdAt: DateTime
        +approve(): void
        +refund(): void
    }

    class PaymentEvent {
        +id: UUID
        +providerEventId: String
        +eventType: String
        +payloadHash: String
        +receivedAt: DateTime
        +processedAt: DateTime
        +process(): void
    }

    enum PaymentProvider {
        STRIPE
    }

    enum PaymentPurpose {
        SALE
    }

    enum PaymentStatus {
        PENDING
        APPROVED
        REFUSED
        EXPIRED
        REFUNDED
    }
}

package "Auditoria" {
    class AuditEvent {
        +id: UUID
        +action: String
        +entityType: String
        +entityId: UUID
        +metadata: JSON
        +createdAt: DateTime
    }
}

User "1" -- "0..*" Listing : owns >
User "1" -- "0..*" Negotiation : participates >
User "1" -- "0..*" TradeOffer : proposes >
User "1" -- "0..*" AuditEvent : triggers >
Book "1" -- "0..*" Listing : advertised as >
Listing "1" *-- "0..*" ListingImage : contains >
Listing "1" -- "0..*" Negotiation : receives >
Negotiation "1" *-- "0..1" TradeOffer : has >
Negotiation "1" *-- "0..1" Payment : requires >
Negotiation "1" -- "0..*" AuditEvent : records >
Payment "1" *-- "0..*" PaymentEvent : receives >

User --> UserRole
User --> UserStatus
Listing --> BookCondition
Listing --> ListingMode
Listing --> ListingStatus
Negotiation --> NegotiationType
Negotiation --> NegotiationStatus
TradeOffer --> TradeOfferStatus
Payment --> PaymentProvider
Payment --> PaymentPurpose
Payment --> PaymentStatus

note right of Payment
  A aplicação não armazena
  dados completos de cartão.
  A confirmação é recebida
  por webhook do Stripe.
end note

@enduml
